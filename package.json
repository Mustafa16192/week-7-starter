{
  "name": "dlm-classroom-qa",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "demo": "EXPO_PUBLIC_USE_EMULATORS=true expo start --web --port 8097",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project project-cdb19",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:rules": "firebase emulators:exec --project demo-dlm-week7 --only firestore \"node --import tsx --test tests/rules.test.ts\"",
    "emulators": "firebase emulators:start --project demo-dlm-week7 --only auth,firestore",
    "seed:demo": "node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "@expo/metro-runtime": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "firebase": "12.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4",
    "react-native-safe-area-context": "~5.10.1",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.20.0",
    "firebase-tools": "14.22.0",
    "@firebase/rules-unit-testing": "5.0.0"
  }
}
