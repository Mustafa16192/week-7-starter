rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dlmWeek7Tasks/{taskId} {
      function signedIn() { return request.auth != null; }
      function validTask() {
        return request.resource.data.keys().hasAll(['title', 'completed', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['title', 'completed', 'createdBy', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 140
          && request.resource.data.title.matches('.*[^\\s].*')
          && request.resource.data.completed is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdAt is timestamp;
      }
      allow read: if signedIn();
      allow create: if signedIn() && validTask()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validTask()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed']);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
